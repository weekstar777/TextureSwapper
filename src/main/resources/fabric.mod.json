{
  "schemaVersion": 1,
  "id": "textureswapper",
  "version": "${version}",
  "name": "TextureSwapper",
  "description": "/textureswapper randomly swaps between the resource packs in the textureswapper folder and vanilla textures",
  "authors": ["weekstar777"],
  "environment": "client",
  "entrypoints": {
    "client": [
      "com.textureswapper.TextureSwapperClient"
    ]
  },
  "mixins": [
    "textureswapper.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.16.0",
    "minecraft": "~1.21",
    "java": ">=21",
    "fabric-api": "*"
  }
}